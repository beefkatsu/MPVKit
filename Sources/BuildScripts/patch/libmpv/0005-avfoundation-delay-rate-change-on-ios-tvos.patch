diff --git forkSrcPrefix/audio/out/ao_avfoundation.m forkDstPrefix/audio/out/ao_avfoundation.m
--- forkSrcPrefix/audio/out/ao_avfoundation.m
+++ forkDstPrefix/audio/out/ao_avfoundation.m
@@ -265,7 +265,13 @@
 #endif
 
     [p->synchronizer addRenderer:p->renderer];
-#if HAVE_MACOS_11_3_FEATURES
+    // On iOS/tvOS keep the system default (delay rate changes until the
+    // renderer has sufficient media): AirPlay routes take seconds to become
+    // ready, and starting the timebase immediately makes mpv sync video to
+    // a clock that runs while no audio can play yet — underruns and A/V
+    // desync until a manual pause/unpause. On macOS keep the eager start
+    // for low-latency local outputs.
+#if HAVE_MACOS_11_3_FEATURES && !TARGET_OS_IPHONE
     if (@available(tvOS 14.5, iOS 14.5, macOS 11.3, *)) {
         [p->synchronizer setDelaysRateChangeUntilHasSufficientMediaData:NO];
     }

+static void engage_rate(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->rate_engaged = true;
+    p->primed_once = true;
+    [p->synchronizer setRate:1];
+}
+
+static void feed(struct ao *ao);
+
+static void start_feeding(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (p->feeding_started)
+        return;
+    p->feeding_started = true;
+    [p->renderer requestMediaDataWhenReadyOnQueue:p->queue usingBlock:^{
+        feed(ao);
+    }];
+}
+
+static void cancel_hold(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (p->hold_block) {
+        dispatch_block_cancel(p->hold_block);
+        p->hold_block = NULL;
+    }
+}

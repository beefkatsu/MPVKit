diff --git a/audio/out/ao_avfoundation.m b/audio/out/ao_avfoundation.m
index a986250..a844550 100644
--- a/audio/out/ao_avfoundation.m
+++ b/audio/out/ao_avfoundation.m
@@ -76,6 +76,15 @@ - (void)handleRestartNotification:(NSNotification*)notification;
     // halt land where nothing is audible and no content clock is running —
     // content then starts continuously. Counted in samples still to inject.
     int64_t preroll_samples;
+    // Resume settle: after a rate restart on a high-latency route the sink
+    // re-anchors its timebase backward (re-sending the in-flight audio the
+    // pause discarded). Reads are withheld until the re-anchor is observed
+    // — with the core clock frozen (resume_thaw_pending), the first read
+    // then anchors timing at post-replay truth and the replay debt is paid
+    // as one short up-front hold instead of a mid-play freeze.
+    int64_t resume_settle_until;
+    int64_t resume_settle_tb;
+    bool resume_settle_refresh;
     // Clock diagnostics (diag build only).
     int64_t diag_last_ns;
     int64_t diag_burst_until_ns;
@@ -184,7 +193,24 @@ static void feed(struct ao *ao)
     int64_t cur_time_mp = mp_time_ns();
     int64_t end_time_av = MPMAX(p->end_time_av, cur_time_av);
 
-    if (p->rate_engaged && p->cap_ns > 0 && end_time_av - cur_time_av > p->cap_ns) {
+    // Resume settle: withhold reads until the sink re-anchors (tb steps
+    // back), starts consuming normally (tb advances), or the window times
+    // out — the renderer plays from its intact queue meanwhile.
+    if (p->resume_settle_until) {
+        if (cur_time_av < p->resume_settle_tb - 50000000 ||
+            cur_time_av > p->resume_settle_tb + 100000000 ||
+            cur_time_mp > p->resume_settle_until) {
+            p->resume_settle_until = 0;
+            p->resume_settle_refresh = true; // one cap-bypass read anchors truth
+            MP_WARN(ao, "[clockdiag] settle-done tb=%.3f (armed at %.3f)\n",
+                    cur_time_av / 1e9, p->resume_settle_tb / 1e9);
+        } else {
+            goto finish;
+        }
+    }
+
+    if (!p->resume_settle_refresh &&
+        p->rate_engaged && p->cap_ns > 0 && end_time_av - cur_time_av > p->cap_ns) {
         if (diag_should_log(ao))
             diag(ao, "capped", 0);
         [p->renderer stopRequestingMediaData];
@@ -262,6 +288,7 @@ static void feed(struct ao *ao)
     }
 
     [p->renderer enqueueSampleBuffer:sample_buffer];
+    p->resume_settle_refresh = false;
 
     time_delta = CMTimeGetNanoseconds(CMTimeMake(real_sample_count, samplerate));
     p->end_time_av = end_time_av + time_delta;
@@ -291,6 +318,8 @@ static void start(struct ao *ao)
     p->rate_engaged = false;
     p->feeding_started = false;
     p->paused = false;
+    p->resume_settle_until = 0;
+    p->resume_settle_refresh = false;
     p->prime_ns = 0;
 #if TARGET_OS_IPHONE
     p->prime_ns = (int64_t)(AVAudioSession.sharedInstance.outputLatency * 1e9);
@@ -385,6 +414,8 @@ static bool set_pause(struct ao *ao, bool paused)
         dispatch_sync(p->queue, ^{
             cancel_hold(ao);
         });
+        p->resume_settle_until = 0;
+        p->resume_settle_refresh = false;
         diag(ao, "pause-pre", -1);
         [p->synchronizer setRate:0];
         diag(ao, "pause-post", -1);
@@ -392,6 +423,13 @@ static bool set_pause(struct ao *ao, bool paused)
         // Unpause always releases a cold-start hold: the user-visible pause
         // has already given the route its warm-up.
         diag(ao, "unpause-pre", -1);
+        // High-latency routes: arm the resume settle before feeding starts
+        // (see struct comment) — the core holds its clock frozen until the
+        // first read we allow through.
+        if (p->prime_ns >= 750000000) {
+            p->resume_settle_tb = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+            p->resume_settle_until = mp_time_ns() + 500000000;
+        }
         start_feeding(ao);
         if (p->rate_engaged)
             [p->synchronizer setRate:1];

+    track->dec = mp_decoder_wrapper_create(parent, track->stream);
+    if (!track->dec)
+        goto err_out;
+
+    if (!mp_decoder_wrapper_reinit(track->dec))
+        goto err_out;
+
+    return 1;
+
+err_out:

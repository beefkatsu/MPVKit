@@ -371,6 +371,18 @@ typedef struct MPContext {
     /* timestamp of video frame currently visible on screen
      * (or at least queued to be flipped by VO) */
     double video_pts;
+    /* audio playback position (playing_audio_pts) captured when the last
+     * frame was handed to the VO; MP_NOPTS_VALUE when unset or audio is not
+     * the sync master. The VO deadline is wall-clock, so if the audio clock
+     * is frozen (AO holding its timebase while priming a device sink), the
+     * next handoff must wait until the clock actually advances. */
+    double last_vo_handoff_apts;
+    /* true while a handoff is being held on a stalled audio clock (above).
+     * The recovery handoff waits until the clock reaches the frame's own pts
+     * and goes out due-now: a deadline baked from the first sign of clock
+     * movement can still be invalidated by a device sink re-anchoring the
+     * clock backward before the frame's flip time. */
+    bool vo_handoff_recovering;
     // Last seek target.
     double last_seek_pts;
     // Frame duration field from demuxer. Only used for duration of the last
diff --git a/player/video.c b/player/video.c
index 0e1ac29..f2a4de0 100644
--- a/player/video.c
+++ b/player/video.c
@@ -112,6 +112,8 @@ void reset_video_state(struct MPContext *mpctx)
     mpctx->delay = 0;
     mpctx->time_frame = 0;
     mpctx->video_pts = MP_NOPTS_VALUE;
+    mpctx->last_vo_handoff_apts = MP_NOPTS_VALUE;
+    mpctx->vo_handoff_recovering = false;
     mpctx->last_frame_duration = 0;
     mpctx->num_past_frames = 0;
     mpctx->total_avsync_change = 0;
@@ -1214,6 +1216,53 @@ void write_video(struct MPContext *mpctx)
         return;
     }
 
+    // The VO deadline below is wall-clock, computed once at handoff. If the
+    // audio clock (the sync master) has not advanced since the previous
+    // handoff — e.g. the AO froze its timebase while (re)priming a device
+    // sink after a resume — a wall deadline still expires, and the VO would
+    // flip this frame during the freeze, one frame ahead of every position
+    // property. Hold the handoff until the clock actually moves.
+    if (mpctx->video_status == STATUS_PLAYING &&
+        mpctx->audio_status == STATUS_PLAYING &&
+        mpctx->ao_chain && mpctx->ao && !ao_untimed(mpctx->ao) &&
+        !mpctx->display_sync_active && !opts->untimed &&
+        !(vo->driver->caps & VO_CAP_UNTIMED) && !vo_c->is_sparse &&
+        mpctx->video_pts != MP_NOPTS_VALUE)
+    {
+        double apts = playing_audio_pts(mpctx);
+        if (apts != MP_NOPTS_VALUE) {
+            if (mpctx->last_vo_handoff_apts == MP_NOPTS_VALUE) {
+                // No baseline yet (the previous handoff happened during
+                // restart, before audio became the sync master): record one
+                // and hold a single poll cycle so this first steady-state
+                // handoff also waits for the clock to demonstrably move.
+                mpctx->last_vo_handoff_apts = apts;
+                mpctx->vo_handoff_recovering = true;
+                mp_set_timeout(mpctx, 0.01);
+                return;
+            }
+            if (apts <= mpctx->last_vo_handoff_apts + 1e-4) {
+                mpctx->vo_handoff_recovering = true;
+                MP_TRACE(mpctx,
+                         "holding frame handoff: audio clock stalled at %f\n",
+                         apts);
+                mp_set_timeout(mpctx, 0.01);
+                return;
+            }
+            if (mpctx->vo_handoff_recovering) {
+                // The clock is moving again, but until it has actually
+                // reached this frame's pts it can still be re-anchored
+                // backward by the sink; a wall deadline baked now would
+                // fire early. Keep holding, then hand off due-now.
+                if (apts < mpctx->next_frames[0]->pts - 0.002) {
+                    mp_set_timeout(mpctx, 0.01);
+                    return;
+                }
+                mpctx->vo_handoff_recovering = false;
+            }
+        }
+    }
+
     double time_frame = MPMAX(mpctx->time_frame, -1);
     int64_t pts = mp_time_ns() + (int64_t)(time_frame * 1e9);
 
@@ -1262,6 +1311,9 @@ void write_video(struct MPContext *mpctx)
     }
 
     mpctx->video_pts = mpctx->next_frames[0]->pts;
+    mpctx->last_vo_handoff_apts =
+        mpctx->audio_status == STATUS_PLAYING && mpctx->ao
+            ? playing_audio_pts(mpctx) : MP_NOPTS_VALUE;
     mpctx->last_frame_duration =
         mpctx->next_frames[0]->pkt_duration / mpctx->video_speed;
 

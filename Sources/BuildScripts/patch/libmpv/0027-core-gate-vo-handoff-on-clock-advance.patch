@@ -1214,6 +1217,65 @@ void write_video(struct MPContext *mpctx)
         return;
     }
 
+    // The VO deadline below is wall-clock, computed once at handoff. If the
+    // audio clock (the sync master) has not advanced since the previous
+    // handoff — e.g. the AO froze its timebase while (re)priming a device
+    // sink after a resume — a wall deadline still expires, and the VO would
+    // flip this frame during the freeze, one frame ahead of every position
+    // property. Hold the handoff until the clock actually moves.
+    if (mpctx->video_status == STATUS_PLAYING &&
+        mpctx->audio_status == STATUS_PLAYING &&
+        mpctx->ao_chain && mpctx->ao && !ao_untimed(mpctx->ao) &&
+        !mpctx->display_sync_active && !opts->untimed &&
+        !(vo->driver->caps & VO_CAP_UNTIMED) && !vo_c->is_sparse &&
+        mpctx->video_pts != MP_NOPTS_VALUE)
+    {
+        double apts = playing_audio_pts(mpctx);
+        if (apts != MP_NOPTS_VALUE) {
+            if (mpctx->last_vo_handoff_apts == MP_NOPTS_VALUE) {
+                // No baseline yet (the previous handoff happened during
+                // restart, before audio became the sync master): record one
+                // and hold a poll cycle so this first steady-state handoff
+                // also waits for the clock to demonstrably move.
+                mpctx->last_vo_handoff_apts = apts;
+                mpctx->vo_handoff_hold_start_ns = mp_time_ns();
+                mp_set_timeout(mpctx, 0.01);
+                return;
+            }
+            if (apts <= mpctx->last_vo_handoff_apts + 1e-4) {
+                int64_t now = mp_time_ns();
+                if (!mpctx->vo_handoff_hold_start_ns)
+                    mpctx->vo_handoff_hold_start_ns = now;
+                // A hold that persists is a real clock freeze (AO priming a
+                // device sink, rate-start halt, dead route) — only then arm
+                // due-now recovery. Sub-threshold holds are just the core
+                // re-entering before the clock measurably moved; they must
+                // release into the ordinary look-ahead deadline or every
+                // frame ships with zero scheduling margin.
+                if (now - mpctx->vo_handoff_hold_start_ns > MP_TIME_MS_TO_NS(150)) {
+                    mpctx->vo_handoff_recovering = true;
+                    MP_TRACE(mpctx,
+                             "holding frame handoff: audio clock frozen at %f\n",
+                             apts);
+                }
+                mp_set_timeout(mpctx, 0.01);
+                return;
+            }
+            mpctx->vo_handoff_hold_start_ns = 0;
+            if (mpctx->vo_handoff_recovering) {
+                // The clock is moving again, but until it has actually
+                // reached this frame's pts it can still be re-anchored
+                // backward by the sink; a wall deadline baked now would
+                // fire early. Keep holding, then hand off due-now.
+                if (apts < mpctx->next_frames[0]->pts - 0.002) {
+                    mp_set_timeout(mpctx, 0.01);
+                    return;
+                }
+                mpctx->vo_handoff_recovering = false;
+            }
+        }
+    }
+
     double time_frame = MPMAX(mpctx->time_frame, -1);
     int64_t pts = mp_time_ns() + (int64_t)(time_frame * 1e9);
 

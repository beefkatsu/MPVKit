diff --git a/player/video.c b/player/video.c
index 0e1ac29..308a74c 100644
--- a/player/video.c
+++ b/player/video.c
@@ -112,6 +112,9 @@ void reset_video_state(struct MPContext *mpctx)
     mpctx->delay = 0;
     mpctx->time_frame = 0;
     mpctx->video_pts = MP_NOPTS_VALUE;
+    mpctx->last_vo_handoff_apts = MP_NOPTS_VALUE;

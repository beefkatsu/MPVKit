+// True remaining playout, measured against the synchronizer's timebase at
+// call time: frozen while the timebase is halted (pause, priming, zombie
+// route), stepping back on a sink re-anchor, immune to how long reads have
+// been withheld. This is what makes the core's reported audio position
+// follow what the sink actually plays instead of wall-clock extrapolation.
+static double get_delay(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    // Load order matters: in-flight first, end second. Seeing a cleared
+    // in-flight then guarantees the end store that preceded the clear is
+    // visible; the residual misordering (stale in-flight + fresh end)
+    // over-reports, which reads as a harmless backward blip — never the
+    // forward blip that bakes early video deadlines.
+    int64_t in_flight = p->transfer_in_flight_ns;
+    int64_t end = p->end_time_av;
+    if (end < 0)
+        return 0;
+    int64_t now = CMTimeGetNanoseconds([p->synchronizer currentTime]);
+    return MPMAX(0, (end + in_flight - now) / 1e9);
+}
